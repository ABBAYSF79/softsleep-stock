generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ConfirmationUser {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  salesmanId Int
  salesman   User     @relation("SalesmanConfirmations", fields: [salesmanId], references: [id])
  linkedSalesUserId Int?
  linkedSalesUser   User?    @relation("LinkedSalesUser", fields: [linkedSalesUserId], references: [id])
  orders     Order[]

  @@index([salesmanId])
  @@index([linkedSalesUserId])
}

model User {
  id             Int            @id @default(autoincrement())
  name           String
  email          String         @unique
  password       String
  role           UserRole       @default(SALES)
  linkedSalesUserId Int?
  linkedSalesUser   User?       @relation("SuiviLinkedSales", fields: [linkedSalesUserId], references: [id])
  suiviUsers        User[]      @relation("SuiviLinkedSales")
  lastActive     DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  active         Boolean        @default(true)
  activities     Activity[]
  orders         Order[]
  enteredOrders  Order[]        @relation("OrderEnteredBy")
  stockHistories StockHistory[]
  pillowStockHistories PillowStockHistory[]
  pillowOrders   PillowOrder[]
  confirmationUsers ConfirmationUser[] @relation("SalesmanConfirmations")
  linkedConfirmationUsers ConfirmationUser[] @relation("LinkedSalesUser")
  invoices       Invoice[]
  deliveryServices UserDeliveryService[]
  stockMovements StockMovement[]

  transfersCreated    Transfer[]      @relation("TransferCreatedBy")
  transfersDispatched Transfer[]      @relation("TransferDispatchedBy")
  transfersCompleted  Transfer[]      @relation("TransferCompletedBy")
  stockDocumentsCreated   StockDocument[] @relation("StockDocumentCreatedBy")
  stockDocumentsValidated StockDocument[] @relation("StockDocumentValidatedBy")
  reservationsCreated Reservation[] @relation("ReservationCreatedBy")

  @@index([linkedSalesUserId])
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  sku         String           @unique
  description String?          @db.Text
  inStock     Boolean          @default(true)
  archived    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id             Int            @id @default(autoincrement())
  productId      Int
  name           String
  skuExt         String
  price          Decimal        @db.Decimal(10, 2)
  weight         Decimal        @default(1.00) @db.Decimal(10, 2)
  stock          Int
  commission     Decimal?       @db.Decimal(10, 2)
  sizeId         Int?
  orderItems     OrderItem[]
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           Size?          @relation(fields: [sizeId], references: [id])
  stockHistories StockHistory[]

  @@unique([productId, skuExt])
  @@index([sizeId], map: "ProductVariant_sizeId_fkey")
}

model Order {
  id                Int              @id @default(autoincrement())
  userId            Int
  enteredByUserId   Int?
  customerName      String
  status            OrderStatus      @default(PENDING)
  totalAmount       Decimal          @db.Decimal(10, 2)
  commission        Decimal          @db.Decimal(10, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  address           String?
  phone             String?
  deliveryServiceId Int?
  city              String?
  trackingCode      String?
  isPaid            Boolean          @default(false)
  note              String?          @db.Text
  livreurNote       String?          @db.Text
  /// Fulfillment inventory location (nullable = LEGACY / UNKNOWN). Never invent WH/SR.
  locationId        Int?
  deliveryService   DeliveryService? @relation(fields: [deliveryServiceId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  enteredBy         User?            @relation("OrderEnteredBy", fields: [enteredByUserId], references: [id])
  location          Location?        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  orderItems        OrderItem[]
  pillowItems       OrderPillowItem[]
  reservations      Reservation[]
  confirmationUserId Int?
  confirmationUser   ConfirmationUser? @relation(fields: [confirmationUserId], references: [id])

  @@index([deliveryServiceId], map: "Order_deliveryServiceId_fkey")
  @@index([userId], map: "Order_userId_fkey")
  @@index([enteredByUserId])
  @@index([locationId])
}

model OrderItem {
  id        Int            @id @default(autoincrement())
  orderId   Int
  variantId Int
  quantity  Int
  price     Decimal        @db.Decimal(10, 2)
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([variantId], map: "OrderItem_variantId_fkey")
}

model StockHistory {
  id            Int             @id @default(autoincrement())
  variantId     Int
  quantity      Int
  type          StockChangeType
  reason        String?
  createdAt     DateTime        @default(now())
  previousStock Int
  newStock      Int
  userId        Int
  user          User            @relation(fields: [userId], references: [id])
  variant       ProductVariant  @relation(fields: [variantId], references: [id])

  @@index([userId])
  @@index([variantId])
}

model Pillow {
  id        Int      @id @default(autoincrement())
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories          PillowStockHistory[]
  orderItems         PillowOrderItem[]
  mattressOrderItems OrderPillowItem[]
  inventoryBalances  InventoryBalance[]
  stockMovements     StockMovement[]
  transferLines      TransferLine[]
  stockDocumentLines StockDocumentLine[]
  reservationLines   ReservationLine[]
}

model OrderPillowItem {
  id       Int     @id @default(autoincrement())
  orderId  Int
  pillowId Int
  quantity Int
  price    Decimal @db.Decimal(10, 2)
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pillow   Pillow  @relation(fields: [pillowId], references: [id])

  @@index([orderId])
  @@index([pillowId])
}

model PillowStockHistory {
  id            Int                  @id @default(autoincrement())
  pillowId      Int
  quantity      Int
  type          PillowStockChangeType
  reason        String?
  createdAt     DateTime             @default(now())
  previousStock Int
  newStock      Int
  userId        Int
  user          User                 @relation(fields: [userId], references: [id])
  pillow        Pillow               @relation(fields: [pillowId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pillowId])
}

model PillowOrder {
  id                Int           @id @default(autoincrement())
  userId            Int
  customerName      String
  phone             String?
  address           String?
  city              String?
  deliveryServiceId Int?
  status            OrderStatus    @default(PENDING)
  totalAmount       Decimal        @db.Decimal(10, 2)
  isPaid            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  /// Fulfillment inventory location (nullable = LEGACY / UNKNOWN). Never invent WH/SR.
  locationId        Int?

  user              User           @relation(fields: [userId], references: [id])
  deliveryService   DeliveryService? @relation(fields: [deliveryServiceId], references: [id])
  location          Location?      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  items             PillowOrderItem[]
  reservations      Reservation[]

  @@index([userId])
  @@index([deliveryServiceId])
  @@index([createdAt])
  @@index([locationId])
}

model PillowOrderItem {
  id       Int        @id @default(autoincrement())
  orderId  Int
  pillowId Int
  quantity Int
  price    Decimal    @db.Decimal(10, 2)

  order    PillowOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pillow   Pillow      @relation(fields: [pillowId], references: [id])

  @@index([orderId])
  @@index([pillowId])
}

model DeliveryService {
  id        Int      @id @default(autoincrement())
  name      String
  active    Boolean  @default(true)
  cities    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  pillowOrders PillowOrder[]
  users     UserDeliveryService[]
}

model UserDeliveryService {
  userId            Int
  deliveryServiceId Int
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryService   DeliveryService @relation(fields: [deliveryServiceId], references: [id], onDelete: Cascade)

  @@id([userId, deliveryServiceId])
  @@index([deliveryServiceId])
}

model CommissionSettings {
  id                 Int      @id @default(autoincrement())
  defaultRate        Decimal  @default(10.00) @db.Decimal(5, 2)
  defaultFixedAmount Decimal? @db.Decimal(10, 2)
  useFixedAmount     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Singleton cutover boundary (TASK 9/15). mode: LEGACY | INVENTORY
/// cutoverStatus: OPEN | FREEZE_PENDING | FROZEN | COMPLETED | ABORTED
model InventoryCutoverSettings {
  id                 Int       @id @default(1)
  mode               String    @default("LEGACY")
  cutoverStatus      String    @default("OPEN")
  cutoverAt          DateTime?
  cutoverDate        String?
  referenceType      String?
  openingFileHash    String?
  notes              String?   @db.Text
  countStartedAt     DateTime?
  countFinalizedAt   DateTime?
  freezeActivatedAt  DateTime?
  freezeActivatedById Int?
  backupConfirmedAt  DateTime?
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())
}

/// Explicit admin transitions for pre-cutover accessory orders (TASK 15).
/// Never auto-created. Actions: CLOSE_UNDER_LEGACY | FREEZE | MIGRATE_TO_INVENTORY
model LegacyOrderTransition {
  id            Int      @id @default(autoincrement())
  source        String
  orderId       Int?
  pillowOrderId Int?
  action        String
  status        String   @default("APPLIED")
  notes         String?  @db.Text
  userId        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([source, orderId])
  @@unique([source, pillowOrderId])
  @@index([action])
}

model Size {
  id        Int              @id @default(autoincrement())
  name      String           @unique
  length    Decimal          @db.Decimal(10, 2)
  width     Decimal          @db.Decimal(10, 2)
  height    Decimal          @db.Decimal(10, 2)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  variants  ProductVariant[]
}

model Activity {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String
  description String
  details     String?  @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Invoice {
  id             Int      @id @default(autoincrement())
  reference      String   @unique
  invoiceNumber  String
  invoiceDate    DateTime
  dueDate        DateTime
  paymentMode    String
  notes          String?  @db.Text

  companyName    String
  companyAddress String   @db.Text
  companyPhone   String?
  companyEmail   String?
  companyRib     String?
  companyIce     String?

  clientName     String
  clientPhone    String?
  clientAddress  String?
  clientCity     String?

  orderIdsJson   String   @db.Text
  itemsJson      String   @db.LongText

  subtotalHt     Decimal  @db.Decimal(10, 2)
  taxRate        Decimal  @db.Decimal(5, 2)
  taxAmount      Decimal  @db.Decimal(10, 2)
  totalTtc       Decimal  @db.Decimal(10, 2)
  currency       String   @default("MAD")

  createdByUserId Int
  createdBy       User    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdByUserId])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  SALES
  LIVREUR
  SUIVI
}

enum OrderStatus {
  PENDING
  IN_PROCESS
  DELIVERED
  RETURNED
}

enum StockChangeType {
  INITIAL
  ORDER
  RETURN
  ADJUSTMENT
  SUPPLY
}

enum PillowStockChangeType {
  INITIAL
  SUPPLY
  OUTGOING
  ADJUSTMENT
}

enum LocationType {
  WAREHOUSE
  SHOWROOM
  OTHER
}

model Location {
  id                 Int          @id @default(autoincrement())
  code               String       @unique
  name               String
  type               LocationType
  active             Boolean      @default(true)
  isSellable         Boolean      @default(true)
  allowsPresentation Boolean      @default(false)
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  transfersFrom     Transfer[]      @relation("TransferSource")
  transfersTo       Transfer[]      @relation("TransferDestination")
  stockDocuments    StockDocument[]
  orders            Order[]
  pillowOrders      PillowOrder[]
  reservations      Reservation[]

  @@index([type])
  @@index([active])
  @@index([sortOrder])
}

// Per-location accessory quantities (TASK 3). available is NEVER stored.
// Pillow.stock remains operational source of truth until a later task.
model InventoryBalance {
  id           Int      @id @default(autoincrement())
  pillowId     Int
  locationId   Int
  physical     Int      @default(0)
  presentation Int      @default(0)
  reserved     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pillow   Pillow   @relation(fields: [pillowId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([pillowId, locationId])
  @@index([pillowId])
  @@index([locationId])
  @@index([locationId, pillowId])
}

enum StockMovementType {
  INITIAL
  SUPPLY
  SALE
  RESERVATION
  RELEASE
  RETURN
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

// Immutable inventory ledger (TASK 4). Corrections = compensating movements only.
// quantity > 0 increases physical (or reserved/presentation delta for non-physical types).
// quantity < 0 decreases physical (or reserved/presentation delta).
model StockMovement {
  id                   Int               @id @default(autoincrement())
  pillowId             Int
  locationId           Int
  type                 StockMovementType
  quantity             Int
  previousPhysical     Int
  newPhysical          Int
  previousPresentation Int
  newPresentation      Int
  previousReserved     Int
  newReserved          Int
  reason               String?
  referenceType        String?
  referenceId          Int?
  referenceNumber      String?
  userId               Int?
  createdAt            DateTime          @default(now())

  pillow   Pillow   @relation(fields: [pillowId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pillowId])
  @@index([locationId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@index([pillowId, locationId, createdAt])
  @@index([userId])
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockDocumentType {
  BON_SORTIE
  BON_ENTREE
}

enum StockDocumentStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

// Internal location transfers (TASK 5). Document foundation only — no InventoryBalance mutations yet.
model Transfer {
  id                    Int            @id @default(autoincrement())
  referenceNumber       String         @unique
  sourceLocationId      Int
  destinationLocationId Int
  status                TransferStatus @default(DRAFT)
  reason                String?
  createdById           Int?
  dispatchedById        Int?
  completedById         Int?
  createdAt             DateTime       @default(now())
  dispatchedAt          DateTime?
  completedAt           DateTime?
  updatedAt             DateTime       @updatedAt

  sourceLocation      Location @relation("TransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation Location @relation("TransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  createdBy           User?    @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  dispatchedBy        User?    @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id], onDelete: SetNull)
  completedBy         User?    @relation("TransferCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  lines               TransferLine[]
  stockDocuments      StockDocument[]

  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([status])
  @@index([createdAt])
}

model TransferLine {
  id               Int      @id @default(autoincrement())
  transferId       Int
  pillowId         Int
  sentQuantity     Int      @default(0)
  receivedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  pillow   Pillow   @relation(fields: [pillowId], references: [id], onDelete: Restrict)

  @@unique([transferId, pillowId])
  @@index([transferId])
  @@index([pillowId])
}

model StockDocument {
  id              Int                 @id @default(autoincrement())
  documentNumber  String              @unique
  type            StockDocumentType
  status          StockDocumentStatus @default(DRAFT)
  transferId      Int?
  locationId      Int
  createdById     Int?
  validatedById   Int?
  reason          String?
  createdAt       DateTime            @default(now())
  validatedAt     DateTime?
  cancelledAt     DateTime?

  transfer    Transfer?           @relation(fields: [transferId], references: [id], onDelete: Restrict)
  location    Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy   User?               @relation("StockDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  validatedBy User?               @relation("StockDocumentValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  lines       StockDocumentLine[]

  @@index([type])
  @@index([status])
  @@index([transferId])
  @@index([locationId])
  @@index([createdAt])
}

model StockDocumentLine {
  id              Int      @id @default(autoincrement())
  stockDocumentId Int
  pillowId        Int
  quantity        Int
  createdAt       DateTime @default(now())

  stockDocument StockDocument @relation(fields: [stockDocumentId], references: [id], onDelete: Cascade)
  pillow        Pillow        @relation(fields: [pillowId], references: [id], onDelete: Restrict)

  @@unique([stockDocumentId, pillowId])
  @@index([stockDocumentId])
  @@index([pillowId])
}

// Concurrency-safe document numbering: TR / BS / BE / RV per year
model DocumentSequence {
  id         Int      @id @default(autoincrement())
  type       String
  year       Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([type, year])
}

// Order accessory reservations (TASK 12). Physical stock is NOT reduced until fulfill.
enum ReservationStatus {
  ACTIVE
  PARTIALLY_FULFILLED
  FULFILLED
  RELEASED
  CANCELLED
}

enum ReservationSource {
  ORDER
  PILLOW_ORDER
}

model Reservation {
  id              Int               @id @default(autoincrement())
  referenceNumber String            @unique
  source          ReservationSource
  orderId         Int?
  pillowOrderId   Int?
  locationId      Int
  status          ReservationStatus @default(ACTIVE)
  idempotencyKey  String            @unique
  createdById     Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  releasedAt      DateTime?
  fulfilledAt     DateTime?
  cancelledAt     DateTime?

  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  pillowOrder PillowOrder? @relation(fields: [pillowOrderId], references: [id], onDelete: Restrict)
  location    Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy   User?        @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines       ReservationLine[]

  @@index([orderId])
  @@index([pillowOrderId])
  @@index([locationId])
  @@index([status])
  @@index([createdAt])
}

model ReservationLine {
  id                Int      @id @default(autoincrement())
  reservationId     Int
  pillowId          Int
  quantity          Int
  fulfilledQuantity Int      @default(0)
  releasedQuantity  Int      @default(0)
  returnedQuantity  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  pillow      Pillow      @relation(fields: [pillowId], references: [id], onDelete: Restrict)

  @@unique([reservationId, pillowId])
  @@index([reservationId])
  @@index([pillowId])
}
