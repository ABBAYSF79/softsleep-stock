# Copy to backend/.env on the server (never commit real secrets).

# Optional: override AMANA search URL
# AMANA_TRACKING_URL=https://bam-tracking.barid.ma/Tracking/Search

# Optional: override hardcoded Turnoxy proxy in AmanaTrackingService.ts
# AMANA_PROXY_URL=http://USER-country-ma:PASS@gate.turnoxy.com:1318

# Parallel test path: DataImpulse Morocco residential (AmanaTrackingDiService)
# AMANA_DI_PROXY_URL=http://LOGIN__cr.ma:PASS@gw.dataimpulse.com:823
# AMANA_DI_PROXY_ENABLED=true
