# Copy to backend/.env on the server (never commit real secrets).

# Optional: override AMANA search URL
# AMANA_TRACKING_URL=https://bam-tracking.barid.ma/Tracking/Search

# Optional: override hardcoded HProxy in AmanaTrackingService.ts
# AMANA_PROXY_URL=http://USER-type-residential-country-ma:PASS@premium.hproxy.com:9000
# AMANA_PROXY_ENABLED=true
